{
  "name": "MAT-Lang Syntax Highlighting",
  "colors": {
    "editor.background": "#1c1c1c",
    "editor.foreground": "#eeffff",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb"
  },
  "tokenColors": [
    {
      "name": "MAT Control Keywords",
      "scope": ["keyword.control.mat"],
      "settings": {
        "foreground": "#C792EA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MAT Declaration Keywords",
      "scope": ["keyword.other.declaration.mat"],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "MAT Primitive Types",
      "scope": ["storage.type.primitive.mat"],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "MAT Custom & Built-in Types",
      "scope": ["support.type.builtin.mat", "entity.name.type.mat"],
      "settings": {
        "foreground": "#FFC66D"
      }
    },
    {
      "name": "MAT Booleans & Constants",
      "scope": ["constant.language.boolean.mat"],
      "settings": {
        "foreground": "#F78C6C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MAT Numbers",
      "scope": [
        "constant.numeric.hex.mat",
        "constant.numeric.binary.mat",
        "constant.numeric.float.mat",
        "constant.numeric.decimal.mat"
      ],
      "settings": {
        "foreground": "#91FA9F"
      }
    },
    {
      "name": "MAT Functions",
      "scope": ["entity.name.function.mat", "support.function.builtin.mat"],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "MAT Operators",
      "scope": [
        "keyword.operator.mutation.mat",
        "keyword.operator.assignment.compound.mat",
        "keyword.operator.bitwise.mat",
        "keyword.operator.comparison.mat",
        "keyword.operator.logical.mat",
        "keyword.operator.arithmetic.mat",
        "keyword.operator.assignment.mat"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "MAT Comments",
      "scope": ["comment.line.double-slash.mat"],
      "settings": {
        "foreground": "#528856",
        "fontStyle": "italic"
      }
    },
    {
      "name": "MAT Strings",
      "scope": ["string.quoted.double.mat"],
      "settings": {
        "foreground": "#C3E88D"
      }
    },
    {
      "name": "MAT String Interpolation Braces",
      "scope": [
        "punctuation.definition.template-expression.begin.mat",
        "punctuation.definition.template-expression.end.mat"
      ],
      "settings": {
        "foreground": "#89DDFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "MAT Punctuation & Brackets",
      "scope": [
        "punctuation.brackets.mat",
        "punctuation.separator.mat",
        "punctuation.separator.namespace.mat",
        "punctuation.separator.arrow.mat",
        "punctuation.terminator.statement.mat"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    }
  ]
}
